# Copy to .env and fill in. Never commit the real file.

# --- Hostaway ---------------------------------------------------------
# Hostaway dashboard -> Settings -> Hostaway API -> Create.
# HOSTAWAY_ACCOUNT_ID is the numeric account id ("client id").
# HOSTAWAY_API_KEY is the long secret shown once when you create the key.
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=
HOSTAWAY_BASE_URL=https://api.hostaway.com/v1

# --- TTLock -----------------------------------------------------------
# clientId/clientSecret come from the TTLock Open Platform developer console.
# TTLOCK_USERNAME / TTLOCK_PASSWORD are the credentials of the TTLock *app*
# account that owns the locks -- not the developer account.
# The password is MD5'd inside the service before it is sent; if you would
# rather not put the plaintext in a file, set TTLOCK_PASSWORD_MD5 instead:
#   printf '%s' 'your-password' | md5sum
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
# TTLOCK_PASSWORD_MD5=
TTLOCK_BASE_URL=https://api.sciener.com

# --- Webhook authentication -------------------------------------------
# Set these, then enter the same values in Hostaway's webhook screen.
# WEBHOOK_PATH_SECRET adds an unguessable path segment; when set, the
# endpoint is /webhooks/hostaway/<secret> and the bare path 404s.
WEBHOOK_BASIC_USER=hostaway
WEBHOOK_BASIC_PASSWORD=change-me-to-something-long
WEBHOOK_PATH_SECRET=

# Bearer token for /admin/*. Leave empty to disable those endpoints entirely.
ADMIN_TOKEN=change-me-too

# --- Service ----------------------------------------------------------
DATABASE_URL=sqlite:////data/bridge.db
UNITS_FILE=/config/units.yaml
LOG_LEVEL=INFO

# Retry pass for failed/pending rows.
RECONCILE_INTERVAL_SECONDS=60
# Full re-read of the booking window from Hostaway (catches lost webhooks).
FULL_SWEEP_MINUTES=15
SWEEP_LOOKBACK_DAYS=3
# How far ahead to push codes onto locks. Bookings beyond this are tracked but
# not written to the lock until they come into range.
HORIZON_DAYS=180
# Grace period after check-out before the code is deleted from the lock.
DELETE_AFTER_CHECKOUT_MINUTES=30

# Copy the code onto the Hostaway reservation's doorCode field so guest
# messaging templates can use it.
WRITE_DOOR_CODE_TO_HOSTAWAY=true

# Set true for a rehearsal: reads everything, writes nothing to any lock.
DRY_RUN=false
